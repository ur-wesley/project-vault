{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Vault",
  "version": "0.9.1",
  "identifier": "io.w4y.project-vault",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Vault",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "Project Vault CLI",
      "subcommands": {
        "issue": {
          "description": "Manage issues",
          "subcommands": {
            "list": {
              "description": "List issues"
            },
            "view": {
              "description": "View an issue",
              "args": [
                {
                  "name": "number",
                  "index": 1,
                  "required": true
                }
              ]
            },
            "create": {
              "description": "Create a new issue",
              "args": [
                {
                  "name": "title",
                  "short": "t",
                  "takesValue": true
                },
                {
                  "name": "body",
                  "short": "b",
                  "takesValue": true
                }
              ]
            },
            "edit": {
              "description": "Edit an issue",
              "args": [
                {
                  "name": "number",
                  "index": 1,
                  "required": true
                },
                {
                  "name": "title",
                  "short": "t",
                  "takesValue": true
                },
                {
                  "name": "body",
                  "short": "b",
                  "takesValue": true
                }
              ]
            },
            "close": {
              "description": "Close an issue",
              "args": [
                {
                  "name": "number",
                  "index": 1,
                  "required": true
                }
              ]
            },
            "reopen": {
              "description": "Reopen an issue",
              "args": [
                {
                  "name": "number",
                  "index": 1,
                  "required": true
                }
              ]
            },
            "delete": {
              "description": "Delete an issue",
              "args": [
                {
                  "name": "number",
                  "index": 1,
                  "required": true
                }
              ]
            }
          }
        }
      }
    },
    "sql": {
      "preload": [
        "sqlite:project-vault.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQzgwODM5MzVENjk4QTAKUldTZ21OWTFPUWpJUTNlbFdlbkdPaXJTU0t2VkRkc0tMYVhiSFI5cFpadEt5UXpsQnhqRHorV2cK",
      "endpoints": [
        "https://github.com/ur-wesley/project-vault/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}